<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Clean URL for posts: /post/slug-name -->
        <rule name="Post Clean URL" stopProcessing="true">
          <match url="^post/([a-z0-9\-]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="post.php?slug={R:1}" />
        </rule>
        
        <!-- Clean URL for packages: /paket/slug-name -->
        <rule name="Package Clean URL" stopProcessing="true">
          <match url="^paket/([a-z0-9\-]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="paket.php?slug={R:1}" />
        </rule>
      </rules>
    </rewrite>
    
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="403" subStatusCode="-1" />
      <error statusCode="403" path="/403.php" responseMode="ExecuteURL" />
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.php" responseMode="ExecuteURL" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500" path="/500.php" responseMode="ExecuteURL" />
    </httpErrors>
    
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(self), camera=(self)" />
        <add name="Feature-Policy" value="geolocation 'self'; camera 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
