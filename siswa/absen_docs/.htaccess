# Allow direct access to evidence files (photos & PDFs)
# These are student-uploaded proof documents for attendance requests

# Disable execution of PHP/scripts as security measure
php_flag engine off

# Allow image and PDF files
<FilesMatch "\.(jpg|jpeg|png|gif|webp|pdf)$">
    Allow from all
</FilesMatch>

# Deny access to all other files for security
<FilesMatch "^(?!.*\.(jpg|jpeg|png|gif|webp|pdf)$)">
    Deny from all
</FilesMatch>

# Set proper content types
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/gif .gif
AddType image/webp .webp
AddType application/pdf .pdf
